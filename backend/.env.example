DATABASE_URL=postgresql://market:market@localhost:5432/market
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Segredo para assinar o cookie de sessão (auth_token) — use um valor aleatório forte em produção
AUTH_SECRET=troque-por-um-segredo-forte

# FastSoft (pagamento Pix) — NUNCA commitar a chave real; o .env real fica fora do git
FASTSOFT_API_URL=https://api.fastsoftbrasil.com
FASTSOFT_SECRET_KEY=
# URL pública HTTPS desta API (monta o postbackUrl do webhook). Sem ela o webhook
# não chega — em dev a confirmação funciona por polling (GET /payments/:id).
PUBLIC_API_URL=
