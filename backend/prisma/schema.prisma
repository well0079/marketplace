generator client {
  provider     = "prisma-client-js"
  // Vercel roda em Amazon Linux 2023 (rhel-openssl-3.0.x); native = dev local
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("customer")
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  addresses Address[]
  carts     Cart[]
  orders    Order[]
  favorites Favorite[]
  reviews   Review[]
  questions Question[]
  offers        Offer[]
  reservations  Reservation[]
  sellerProfile SellerProfile?
  listings      Listing[]
  // Tema ingressos: celular verificado em E.164 e CPF só mascarado + hash (nunca completo)
  phone           String?   @unique
  phoneVerifiedAt DateTime?
  cpfMasked       String?
  cpfHash         String?   @unique
  marketingOptIn  Boolean   @default(false)
}

// Desafio do cadastro em 3 passos (sem sessão até concluir): código hashado no
// servidor (nunca dentro do token), expira em 10 min, máx. 5 tentativas
model SignupChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String?
  attempts   Int       @default(0)
  verifiedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  @@index([phone])
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  label      String?
  recipient  String
  zipCode    String
  street     String
  number     String
  complement String?
  district   String
  city       String
  state      String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Category {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  slug     String  @unique
  parentId String? @db.Uuid
  icon     String?
  position Int     @default(0)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
  @@index([parentId])
}

model Product {
  id            String   @id @default(uuid()) @db.Uuid
  categoryId    String   @db.Uuid
  title         String
  slug          String   @unique
  description   String
  brand         String?
  price         Int
  originalPrice Int?
  freeShipping  Boolean  @default(false)
  condition     String   @default("new")
  status        String   @default("active")
  ratingAvg     Float    @default(0)
  ratingCount   Int      @default(0)
  soldCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  category  Category         @relation(fields: [categoryId], references: [id])
  images    ProductImage[]
  variants  ProductVariant[]
  favorites Favorite[]
  reviews   Review[]
  questions Question[]
  @@index([categoryId])
  @@index([status, createdAt])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  url       String
  alt       String?
  position  Int      @default(0)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, position])
}

// Regra: todo produto tem >= 1 variante (produto simples = attributes {}). CHECK stock>=0 em service.
model ProductVariant {
  id            String  @id @default(uuid()) @db.Uuid
  productId     String  @db.Uuid
  attributes    Json
  priceOverride Int?
  stock         Int     @default(0)
  active        Boolean @default(true)
  createdAt     DateTime @default(now())
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]
  @@index([productId])
}

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String?  @db.Uuid
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user  User?      @relation(fields: [userId], references: [id])
  items CartItem[]
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @db.Uuid
  variantId String   @db.Uuid
  quantity  Int
  addedAt   DateTime @default(now())
  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])
  @@unique([cartId, variantId])
}

model Order {
  id              String    @id @default(uuid()) @db.Uuid
  code            String    @unique
  userId          String    @db.Uuid
  status          String    @default("pending")
  subtotal        Int
  shippingCost    Int       @default(0)
  discount        Int       @default(0)
  total           Int
  shippingAddress Json?
  deliveryOption  Json?
  idempotencyKey  String    @unique
  expiresAt       DateTime?
  cancelledAt     DateTime?
  needsReview     Boolean   @default(false)
  // Pedidos de ingresso (fluxo reserva): snapshot completo; cart/orders de produto deixam nulos
  ticketSnapshot  Json?
  reservationId   String?   @db.Uuid
  couponId        String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user     User        @relation(fields: [userId], references: [id])
  items    OrderItem[]
  payments Payment[]
  coupon   Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt(sort: Desc)])
}

model OrderItem {
  id              String   @id @default(uuid()) @db.Uuid
  orderId         String   @db.Uuid
  // nulo em pedidos de ingresso (snapshot vive em Order.ticketSnapshot)
  variantId       String?  @db.Uuid
  productSnapshot Json
  unitPrice       Int
  quantity        Int
  lineTotal       Int
  createdAt       DateTime @default(now())
  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])
  @@index([orderId])
}

model Payment {
  id                    String    @id @default(uuid()) @db.Uuid
  orderId               String    @db.Uuid
  provider              String    @default("fastsoft")
  providerTransactionId String?   @unique
  method                String?
  status                String    @default("created")
  amount                Int
  pixQrCode             String?
  pixExpiresAt          DateTime?
  payerDocumentMasked   String?
  paidAt                DateTime?
  lastSyncedAt          DateTime?
  requestPayload        Json?
  responsePayload       Json?
  idempotencyKey        String    @unique
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  order  Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events PaymentEvent[]
  @@index([orderId])
}

model PaymentEvent {
  id                    String    @id @default(uuid()) @db.Uuid
  paymentId             String?   @db.Uuid
  providerTransactionId String?
  providerEventId       String?   @unique
  dedupeKey             String?   @unique
  eventType             String
  rawPayload            Json
  signatureValid        Boolean   @default(false)
  receivedAt            DateTime  @default(now())
  processedAt           DateTime?
  payment Payment? @relation(fields: [paymentId], references: [id])
}

model Favorite {
  userId    String   @db.Uuid
  productId String   @db.Uuid
  createdAt DateTime @default(now())
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([userId, productId])
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  userId    String   @db.Uuid
  orderId   String?
  rating    Int
  title     String?
  comment   String?
  createdAt DateTime @default(now())
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([productId, userId])
}

model Question {
  id         String    @id @default(uuid()) @db.Uuid
  productId  String    @db.Uuid
  userId     String    @db.Uuid
  question   String
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime  @default(now())
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([productId, createdAt(sort: Desc)])
}

// ═══ Tema ingressos (ETAPA 2+3, bloco 1) ═══

// Regras: disponível = quantity - soma de reservas ativas não expiradas;
// a oferta só perde estoque (quantity) na confirmação do pagamento.
model Event {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  category    String
  organizer   String
  description String
  // placeholder: nulo = gradiente por categoria no frontend (nada é copiado do site de referência)
  imageUrl    String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  sessions EventSession[]
  @@index([featured, createdAt])
}

model EventSession {
  id       String   @id @default(uuid()) @db.Uuid
  eventId  String   @db.Uuid
  startsAt DateTime
  city     String
  uf       String
  venue    String
  event   Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  offers  Offer[]
  listings Listing[]
  @@index([eventId, startsAt])
}

// ticketType = área (Pista, Área VIP, Camarote); ticketCategory = modalidade (Inteira, Meia, Solidário)
// sellerId nulo = venda pela plataforma
model Offer {
  id             String   @id @default(uuid()) @db.Uuid
  sessionId      String   @db.Uuid
  ticketType     String
  ticketCategory String
  priceCents     Int
  quantity       Int
  sellerId       String?  @db.Uuid
  status         String   @default("active") // active | pending_review | sold | cancelled
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  session      EventSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  seller       User?         @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  reservations Reservation[]
  listing      Listing?
  @@index([sessionId, status, priceCents])
}

// Perfil do vendedor: verificação "básica" (consentimento + endereço de cobrança).
// Sem CPF novo (vínculo = conta), sem upload de documento, sem biometria, sem KYC.
model SellerProfile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  verificationLevel String   @default("basic")
  consentAt         DateTime
  cep               String
  uf                String
  city              String
  neighborhood      String
  street            String
  number            String
  complement        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Anúncio de ingresso por sessão. sellerId nulo = plataforma.
// status: active (à venda) | pending_review (aguardando moderação) | sold | cancelled
model Listing {
  id             String   @id @default(uuid()) @db.Uuid
  sessionId      String   @db.Uuid
  sellerId       String   @db.Uuid
  ticketType     String
  ticketCategory String
  quantity       Int
  priceCents     Int
  status         String   @default("active")
  offerId        String?  @unique @db.Uuid
  createdAt      DateTime @default(now())
  session EventSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  seller  User             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  offer   Offer?           @relation(fields: [offerId], references: [id], onDelete: SetNull)
  @@index([sessionId, status])
  @@index([sellerId, status])
}

// Cupom de desconto do tema ingressos: desconto sobre o PREÇO do ingresso; a taxa
// de 10% é recalculada sobre o valor com desconto; total mínimo R$ 1,00 (recusa).
model Coupon {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique
  percentOff  Int
  validFrom   DateTime  @default(now())
  validTo     DateTime
  maxUses     Int
  usedCount   Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  orders Order[]
  @@index([code])
}

model Reservation {
  id        String   @id @default(uuid()) @db.Uuid
  offerId   String   @db.Uuid
  userId    String   @db.Uuid
  quantity  Int
  expiresAt DateTime
  status    String   @default("active") // active | expired | cancelled | converted
  createdAt DateTime @default(now())
  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([offerId, status, expiresAt])
  @@index([userId, status, expiresAt])
}
